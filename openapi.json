          "event": {
            "type": "string",
            "description": "(Accessory) Event ID (or the full document with `populate`)."
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "HistoryPrice": {

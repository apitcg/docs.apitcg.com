                  }
                }
              },
              "tcgmatch": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "url": { "type": "string" },
                  "prices": {
                    "type": "object",
                    "properties": {
                      "low": { "type": "number", "example": 0.15 },

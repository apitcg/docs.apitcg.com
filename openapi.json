                    "type": "object",
                    "properties": {
                      "low": { "type": "number", "example": 0.15 },
                      "mid": { "type": "number", "example": 0.35 },
                      "high": { "type": "number", "example": 2.5 },
                      "market": { "type": "number", "example": 0.31 }
